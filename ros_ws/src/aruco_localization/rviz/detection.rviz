Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Marker Scale: 0.4
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Frame Timeout: 2
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Detected markers
    Enabled: true
    Namespaces: {}
    Topic:
      Value: /detected_markers_viz
      Depth: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Value: true
  - Class: rviz_default_plugins/Image
    Name: Camera
    Enabled: true
    Normalize Range: true
    Topic:
      Value: /camera/image_annotated
      Depth: 2
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.07
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0.8
        Y: 0.0
        Z: 0.2
      Pitch: 0.9
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Near Clip Distance: 0.01
      Value: Orbit (rviz)
    Saved: []
Window Geometry:
  Height: 900
  Width: 1500
  X: 50
  Y: 50
